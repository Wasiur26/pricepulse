# Server & Database Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pricepulse
CLIENT_ORIGIN=http://localhost:3000

# High-Frequency Job Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_STARTUP=true
SCHEDULER_CRON=* * * * *
SCHEDULER_ADMIN_TOKEN=your-optional-admin-secret-token

# Scraping & Proxy Configuration (Optional / Placeholders)
SCRAPER_TIMEOUT_MS=15000
# SCRAPER_PROXY_URL=https://api.scraperapi.com
# SCRAPER_API_KEY=your_scraper_api_key_here

# Notification & Alerting Placeholders (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
